# ---- Required for AI moment detection (get one at https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
# Leave empty to use the app default; if Google retires a model the app switches to the one Google suggests.
GEMINI_MODEL=

# ---- Local AI via Ollama on this PC (free, no quota). Default model: qwen2.5vl:3b (run: ollama pull qwen2.5vl:3b)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5vl:3b

# ---- Required for YouTube upload (Phase 2) ----
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (type: Web application)
# Authorised redirect URI must be exactly: http://localhost:8080/api/youtube/callback
# Enable "YouTube Data API v3" (and optionally "YouTube Analytics API") for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=http://localhost:8080

# ---- Security: used to encrypt stored YouTube tokens. Use a long random string. ----
APP_SECRET=change-me-to-a-long-random-string
# Optional: protect the dashboard/API with a password (HTTP basic auth, user "admin")
APP_PASSWORD=

# ---- Speech recognition (local Whisper container). tiny|base|small|medium|large-v3 ----
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- Workers ----
ANALYZE_CONCURRENCY=2
RENDER_CONCURRENCY=1
UPLOAD_CONCURRENCY=1

# ---- Storage: local (default, Docker volume) or s3 (any S3-compatible: AWS, R2, MinIO) ----
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Where recordings and finished Shorts are stored on your PC (default D:/clipforge-data) ----
DATA_PATH=D:/clipforge-data

PORT=8080
